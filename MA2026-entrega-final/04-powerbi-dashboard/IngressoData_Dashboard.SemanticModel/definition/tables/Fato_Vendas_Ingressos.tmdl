table Fato_Vendas_Ingressos
	lineageTag: 63f0e0fa-27cb-5121-81ab-246ca443c64e

	measure 'Faturamento Total' = SUM ( Fato_Vendas_Ingressos[Valor_Total] )
		formatString: \R$ #,0.00
		lineageTag: 6a66211d-6097-5b9c-862b-29ce815e42e7

	measure 'Ingressos Vendidos' = SUM ( Fato_Vendas_Ingressos[Qtd] )
		formatString: #,0
		lineageTag: e5e52272-5248-5d42-bc6f-8dbcc0b3eb00

	measure Pedidos = DISTINCTCOUNT ( Fato_Vendas_Ingressos[ID_Venda] )
		formatString: #,0
		lineageTag: 75c0f8d1-5558-596e-8e01-62baf40a114a

	measure 'Ticket Médio' = DIVIDE ( [Faturamento Total], [Ingressos Vendidos] )
		formatString: \R$ #,0.00
		lineageTag: db7bf4dd-5287-5148-9019-5ebf2aa7453d

	measure 'Ticket Médio por Pedido' = DIVIDE ( [Faturamento Total], [Pedidos] )
		formatString: \R$ #,0.00
		lineageTag: 6ea2f724-0a69-587f-acbe-7f04f9776e43

	measure 'Faturamento Turista' = CALCULATE ( [Faturamento Total], Fato_Vendas_Ingressos[Origem_Publico] <> "Local" )
		formatString: \R$ #,0.00
		lineageTag: 03cc9e7c-9b24-50d3-ad07-7bcdc787097d

	measure '% Faturamento Turista' = DIVIDE ( [Faturamento Turista], [Faturamento Total] )
		formatString: 0.0%
		lineageTag: 1b9bfae2-afcb-5cbc-baa4-1f993b249f32

	measure Compradores = DISTINCTCOUNT ( Fato_Vendas_Ingressos[Comprador_ID] )
		formatString: #,0
		lineageTag: 453aa4ba-5ac2-5938-85d2-725c921096b5

	measure 'Compradores Turistas' = CALCULATE ( [Compradores], Fato_Vendas_Ingressos[Origem_Publico] <> "Local" )
		formatString: #,0
		lineageTag: 5a034cf5-0e5f-5038-8e48-0334fcdd3d4c

	measure '% Compradores Turistas' = DIVIDE ( [Compradores Turistas], [Compradores] )
		formatString: 0.0%
		lineageTag: 7d12ae97-c1c0-5fb9-9118-7e9f6e53e860

	measure 'Participação Categoria' = DIVIDE ( [Faturamento Total], CALCULATE ( [Faturamento Total], ALL ( Fato_Vendas_Ingressos[Categoria] ), ALL ( Dim_Evento[Categoria] ) ) )
		formatString: 0.0%
		lineageTag: 4ecc891a-b628-5ba4-96b3-38676cf60919

	measure 'Faturamento Ao Ar Livre' = CALCULATE ( [Faturamento Total], Dim_Evento[Ao_Ar_Livre] = "Sim" )
		formatString: \R$ #,0.00
		lineageTag: f45a176e-56bf-5be6-82b9-974312e7f714

	measure 'Faturamento Mês Anterior' = CALCULATE ( [Faturamento Total], DATEADD ( Dim_Calendario[Data], -1, MONTH ) )
		formatString: \R$ #,0.00
		lineageTag: c2078eca-ad29-59b7-8300-367a4efb2fb5

	measure 'Variação Mensal %' = DIVIDE ( [Faturamento Total] - [Faturamento Mês Anterior], [Faturamento Mês Anterior] )
		formatString: 0.0%
		lineageTag: b018535e-b299-5f25-b55f-d852bc5b0a32

	measure 'Dólar Médio' = AVERAGE ( Fato_Vendas_Ingressos[Dolar_no_Dia_da_Venda] )
		formatString: 0.00
		lineageTag: 2d7020b0-06ef-590a-926b-dd3f371e11f5

	measure 'Ingressos Turista Internacional' = CALCULATE ( [Ingressos Vendidos], Fato_Vendas_Ingressos[Origem_Publico] = "Turista Internacional" )
		formatString: #,0
		lineageTag: bee80998-0320-5c0b-9b17-a6eced76ae7f

	measure 'Visitantes Internacionais' = SUM ( Fato_Visitantes_Internacionais[Visitantes] )
		formatString: #,0
		lineageTag: 3ac9d8ff-b665-5a82-9f7b-d4dd310ee95f

