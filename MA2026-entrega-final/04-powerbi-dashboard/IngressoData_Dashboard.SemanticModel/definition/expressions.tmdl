expression pPastaDados = "C:\Dev\fatecsp-MA20262-equipe-13-ingressodata\MA2026-entrega-parcial\01-excel\dados-brutos\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 10bf6524-b3a3-5207-8f01-69ab8eda6c6d

	annotation PBI_ResultType = Text

expression fnTratarData =
		// Converte qualquer formato de data das planilhas brutas em data:
		// data/datahora do Excel (RJ), texto dd/mm/aaaa (SP) e texto aaaa-mm-dd (MG)
		(valor as any) as nullable date =>
		let
		    Texto = if valor = null then "" else Text.Trim(Text.From(valor)),
		    Resultado =
		        if valor = null or Texto = "" then null
		        else if Value.Is(valor, type date) then valor
		        else if Value.Is(valor, type datetime) then Date.From(valor)
		        else if Value.Is(valor, type number) then Date.From(valor)
		        else if Text.Middle(Texto, 4, 1) = "-" then
		            #date(
		                Number.From(Text.Start(Texto, 4)),
		                Number.From(Text.Middle(Texto, 5, 2)),
		                Number.From(Text.Middle(Texto, 8, 2)))
		        else
		            #date(
		                Number.From(Text.Middle(Texto, 6, 4)),
		                Number.From(Text.Middle(Texto, 3, 2)),
		                Number.From(Text.Start(Texto, 2)))
		in
		    Resultado
	lineageTag: a6dad598-9d82-506e-ae2d-cecc16a637c9

	annotation PBI_ResultType = Function

expression fnTratarNumero =
		// Converte "R$ 1.250,00", "450,00", número ou vazio em número (vazio vira 0 e é descartado depois)
		(valor as any) as number =>
		let
		    Texto = if valor = null or Value.Is(valor, type number) then "" else Text.Trim(Text.Replace(Text.From(valor), "R$", "")),
		    Resultado =
		        if valor = null then 0
		        else if Value.Is(valor, type number) then valor
		        else if Texto = "" then 0
		        else try Number.FromText(Texto, "pt-BR") otherwise 0
		in
		    Resultado
	lineageTag: aa2cb368-1769-5d51-bd47-fd01685b5c95

	annotation PBI_ResultType = Function

expression fnLerAba =
		// Lê uma aba de um arquivo .xlsx da pasta de dados, já com a primeira linha como cabeçalho
		(arquivo as text, aba as text) as table =>
		let
		    Fonte = Excel.Workbook(File.Contents(pPastaDados & arquivo), true, true),
		    Dados = Fonte{[Item = aba, Kind = "Sheet"]}[Data]
		in
		    Dados
	lineageTag: 1bb6dd56-b7e3-53b4-8409-eb958c66bc79

	annotation PBI_ResultType = Function

expression DePara_Categoria =
		// Tabela de padronização (Original em minúsculas -> Padrao). Editar em tabelas_apoio.xlsx
		let
		    Fonte = fnLerAba("tabelas_apoio.xlsx", "DePara_Categoria"),
		    Tipos = Table.TransformColumnTypes(Fonte, {{"Original", type text}, {"Padrao", type text}})
		in
		    Tipos
	lineageTag: c6c41f44-63a8-5e6f-9446-4e6f63b2cfc4

	annotation PBI_ResultType = Table

